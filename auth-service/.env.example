# =====================
# AWS RDS PostgreSQL
# =====================
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/polleria_auth
DB_USERNAME=polleria_admin
DB_PASSWORD=tu_password_seguro

# =====================
# JWT (mínimo 32 caracteres)
# =====================
JWT_SECRET=cambia_esto_por_una_clave_super_secreta_de_al_menos_32_chars
JWT_EXPIRATION_MS=86400000

# =====================
# Bloqueo de IP
# =====================
MAX_FAILED_ATTEMPTS=5
BLOCK_DURATION_MINUTES=15

# =====================
# Email para 2FA (Gmail)
# =====================
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail

# =====================
# CORS (URL del frontend Angular)
# =====================
CORS_ALLOWED_ORIGINS=http://localhost:4200

# =====================
# Puerto del servicio
# =====================
PORT=8081
