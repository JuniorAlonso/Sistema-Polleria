POST {{INCIDENT_URL}}/incidentes
X-Internal-Key: {{INTERNAL_KEY}}
Content-Type: application/json

{ "titulo": "Timeout con pasarela (prueba 06)", "severidad": "BAJA", "tipo": "TECNICO", "descripcion": "La pasarela tardo mas de 5 s en responder" }

