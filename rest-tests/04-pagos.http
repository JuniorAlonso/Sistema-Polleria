###############################################################################
# 04 - PAGOS (payments-service :8083) de punta a punta
# Extension: REST Client (humao.rest-client). Runner: node runner/run-http.mjs
#
# Cubre PagoController (/pagos) y MercadoPagoWebhookController (/pagos/webhook).
# Cada flujo crea su propia orden en orders-service (POST /ordenes como CLIENTE)
# y la deja cerrada al final (CANCELADO / ENTREGADO), sin tocar datos ajenos.
#
# Pasarelas externas en local (docker-compose.local.yml):
#   - MERCADOPAGO_ACCESS_TOKEN de sandbox configurado: medios de pago, preferencia
#     y TARJETA/YAPE_PLIN via POST /pagos llaman a la API sandbox de Mercado Pago.
#   - PAYMENTS_YAPE_OTP_MOCK_ENABLED no definido: /pagos/yape-otp responde 409.
#   - MERCADOPAGO_WEBHOOK_SECRET vacio con MERCADOPAGO_SANDBOX=true: el webhook
#     acepta notificaciones sin firma (esFirmaValida devuelve true). El rechazo
#     401 por firma invalida solo ocurre con secret configurado o sandbox=false.
#
# 2FA: ADMIN, MOZO, COCINA, REPARTIDOR y CAJERO reciben un codigo por correo.
# En REST Client: copia el codigo (correo o tabla two_factor_tokens) en @OTP_*.
# El runner lo lee solo de Postgres con la directiva "# @otp".
###############################################################################

@AUTH_URL = http://localhost:8081
@ORDERS_URL = http://localhost:8082
@PAYMENTS_URL = http://localhost:8083
@PASSWORD = Password123!
@INTERNAL_KEY = {{$dotenv INTERNAL_API_KEY}}

@OTP_ADMIN = 000000
@OTP_MOZO = 000000
@OTP_COCINA = 000000
@OTP_REPARTIDOR = 000000
@OTP_CAJERO = 000000

# Producto sembrado sin control de stock (stock NULL): no agota el catalogo.
@PRODUCTO_ID = 1
@ORDEN_INEXISTENTE = 999999999
@PAGO_INEXISTENTE = 999999999
@TEL_A = 9{{$randomInt 10000000 99999999}}
@TEL_H = 9{{$randomInt 10000000 99999999}}
@IDEM_A = pagos-04-{{$guid}}
@LIQ_ID = {{$timestamp}}
@LIQ_OTRA = 7{{$timestamp}}

@TOKEN_CLIENTE = {{loginCliente.response.body.$.token}}
@TOKEN_ADMIN = {{loginAdmin.response.body.$.token}}
@TOKEN_MOZO = {{loginMozo.response.body.$.token}}
@TOKEN_COCINA = {{loginCocina.response.body.$.token}}
@TOKEN_REPARTIDOR = {{loginRepartidor.response.body.$.token}}
@TOKEN_CAJERO = {{loginCajero.response.body.$.token}}

###############################################################################
# 0. SESIONES
###############################################################################

### 0.1 Login CLIENTE (sin 2FA)
# Esperado: HTTP 200
# @assert $.token exists
# @name loginCliente
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "cliente.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.2 Login ADMIN - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "admin.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.3 Login ADMIN - paso 2
# Esperado: HTTP 200
# @otp OTP_ADMIN admin.polleria@yopmail.com
# @assert $.role == ADMIN
# @name loginAdmin
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "admin.polleria@yopmail.com", "code": "{{OTP_ADMIN}}" }

### 0.4 Login MOZO - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "mozo.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.5 Login MOZO - paso 2
# Esperado: HTTP 200
# @otp OTP_MOZO mozo.polleria@yopmail.com
# @assert $.role == MOZO
# @name loginMozo
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "mozo.polleria@yopmail.com", "code": "{{OTP_MOZO}}" }

### 0.6 Login COCINA - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "cocina.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.7 Login COCINA - paso 2
# Esperado: HTTP 200
# @otp OTP_COCINA cocina.polleria@yopmail.com
# @assert $.role == COCINA
# @name loginCocina
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "cocina.polleria@yopmail.com", "code": "{{OTP_COCINA}}" }

### 0.8 Login REPARTIDOR - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "repartidor.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.9 Login REPARTIDOR - paso 2
# Esperado: HTTP 200
# @otp OTP_REPARTIDOR repartidor.polleria@yopmail.com
# @assert $.role == REPARTIDOR
# @name loginRepartidor
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "repartidor.polleria@yopmail.com", "code": "{{OTP_REPARTIDOR}}" }

### 0.10 Login CAJERO - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "cajero.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.11 Login CAJERO - paso 2
# Esperado: HTTP 200
# @otp OTP_CAJERO cajero.polleria@yopmail.com
# @assert $.role == CAJERO
# @name loginCajero
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "cajero.polleria@yopmail.com", "code": "{{OTP_CAJERO}}" }

###############################################################################
# 1. MEDIOS DE PAGO (publico, consulta real a Mercado Pago sandbox)
###############################################################################

### 1.1 Medios de pago - ruta corta publica
# Esperado: HTTP 200
# @assert $[0].id exists
GET {{PAYMENTS_URL}}/pagos/medios-pago

### 1.2 Medios de pago - ruta /mercadopago publica
# Esperado: HTTP 200
# @assert $[0].id exists
GET {{PAYMENTS_URL}}/pagos/mercadopago/medios-pago

###############################################################################
# 2. FLUJO A - CONTRAENTREGA: iniciar -> confirmar -> reembolso parcial y total
###############################################################################

### 2.1 CLIENTE crea orden DELIVERY (queda PENDIENTE_PAGO)
# Esperado: HTTP 201
# @assert $.estado == PENDIENTE_PAGO
# @assert $.total exists
# @name ordenA
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{
  "tipo": "DELIVERY",
  "direccionEntrega": "Av. Pruebas 404, Lima",
  "nombreCliente": "Cliente Pagos A",
  "telefonoCliente": "{{TEL_A}}",
  "items": [ { "productoId": {{PRODUCTO_ID}}, "cantidad": 1 } ]
}

### 2.2 Iniciar pago sin token es rechazado (anonimo = 403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos
Content-Type: application/json

{ "ordenId": {{ordenA.response.body.$.id}}, "monto": {{ordenA.response.body.$.total}}, "metodoPago": "CONTRAENTREGA" }

### 2.3 MOZO no inicia pagos (403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_MOZO}}
Content-Type: application/json

{ "ordenId": {{ordenA.response.body.$.id}}, "monto": {{ordenA.response.body.$.total}}, "metodoPago": "CONTRAENTREGA" }

### 2.4 Iniciar pago sin metodoPago (400 validacion)
# Esperado: HTTP 400
# @assert $.detail contains metodoPago requerido
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "ordenId": {{ordenA.response.body.$.id}}, "monto": {{ordenA.response.body.$.total}} }

### 2.5 Iniciar pago con monto distinto al total de la orden (409)
# Esperado: HTTP 409
# @assert $.detail contains no coincide con el total
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "ordenId": {{ordenA.response.body.$.id}}, "monto": 0.50, "metodoPago": "CONTRAENTREGA" }

### 2.6 Iniciar pago de una orden inexistente (404)
# Esperado: HTTP 404
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "ordenId": {{ORDEN_INEXISTENTE}}, "monto": 10.00, "metodoPago": "CONTRAENTREGA" }

### 2.7 CLIENTE inicia pago CONTRAENTREGA (PENDIENTE, referencia COD-)
# Esperado: HTTP 201
# @assert $.estado == PENDIENTE
# @assert $.metodoPago == CONTRAENTREGA
# @assert $.referenciaExterna contains COD-
# @name pagoA
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "ordenId": {{ordenA.response.body.$.id}}, "monto": {{ordenA.response.body.$.total}}, "metodoPago": "CONTRAENTREGA" }

### 2.8 Un segundo pago para la misma orden es rechazado (409)
# Esperado: HTTP 409
# @assert $.detail contains Ya existe un pago
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "ordenId": {{ordenA.response.body.$.id}}, "monto": {{ordenA.response.body.$.total}}, "metodoPago": "CONTRAENTREGA" }

### 2.9 CLIENTE consulta su pago por id
# Esperado: HTTP 200
# @assert $.id == {{pagoA.response.body.$.id}}
# @assert $.ordenId == {{ordenA.response.body.$.id}}
GET {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}
Authorization: Bearer {{TOKEN_CLIENTE}}

### 2.10 Detalle de pago sin token (403)
# Esperado: HTTP 403
GET {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}

### 2.11 Detalle de pago inexistente (404)
# Esperado: HTTP 404
GET {{PAYMENTS_URL}}/pagos/{{PAGO_INEXISTENTE}}
Authorization: Bearer {{TOKEN_ADMIN}}

### 2.12 MOZO consulta el pago por orden
# Esperado: HTTP 200
# @assert $.id == {{pagoA.response.body.$.id}}
GET {{PAYMENTS_URL}}/pagos/orden/{{ordenA.response.body.$.id}}
Authorization: Bearer {{TOKEN_MOZO}}

### 2.13 Pago por orden con clave interna (notification/orders)
# Esperado: HTTP 200
# @assert $.id == {{pagoA.response.body.$.id}}
GET {{PAYMENTS_URL}}/pagos/orden/{{ordenA.response.body.$.id}}
X-Internal-Key: {{INTERNAL_KEY}}

### 2.14 Pago por orden inexistente (404)
# Esperado: HTTP 404
GET {{PAYMENTS_URL}}/pagos/orden/{{ORDEN_INEXISTENTE}}
Authorization: Bearer {{TOKEN_ADMIN}}

### 2.15 CLIENTE ve el pago en mis-pagos
# Esperado: HTTP 200
# @assert $ contains "id":{{pagoA.response.body.$.id}},
GET {{PAYMENTS_URL}}/pagos/mis-pagos
Authorization: Bearer {{TOKEN_CLIENTE}}

### 2.16 MOZO tambien puede consultar mis-pagos (lista propia)
# Esperado: HTTP 200
GET {{PAYMENTS_URL}}/pagos/mis-pagos
Authorization: Bearer {{TOKEN_MOZO}}

### 2.17 ADMIN no tiene mis-pagos (403)
# Esperado: HTTP 403
GET {{PAYMENTS_URL}}/pagos/mis-pagos
Authorization: Bearer {{TOKEN_ADMIN}}

### 2.18 CLIENTE no confirma pagos (403)
# Esperado: HTTP 403
PATCH {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/confirmar
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "referenciaExterna": "CAJA-04-A" }

### 2.19 Confirmar sin referenciaExterna (400)
# Esperado: HTTP 400
# @assert $.detail contains referenciaExterna requerida
PATCH {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/confirmar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "detalle": "sin referencia" }

### 2.20 CAJERO confirma el pago (APROBADO)
# Esperado: HTTP 200
# @assert $.estado == APROBADO
# @assert $.referenciaExterna == CAJA-04-A
PATCH {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/confirmar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "referenciaExterna": "CAJA-04-A", "detalle": "Cobro en caja (prueba 04)" }

### 2.21 Confirmar dos veces es idempotente (sigue APROBADO)
# Esperado: HTTP 200
# @assert $.estado == APROBADO
PATCH {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/confirmar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "referenciaExterna": "CAJA-04-A" }

### 2.22 El pago aprobado mueve la orden a RECIBIDO (cola de cocina)
# Esperado: HTTP 200
# @sleep 2000
# @assert $.estado == RECIBIDO
GET {{ORDERS_URL}}/ordenes/{{ordenA.response.body.$.id}}
Authorization: Bearer {{TOKEN_CLIENTE}}

### 2.23 Cancelar un pago APROBADO no esta permitido (409)
# Esperado: HTTP 409
# @assert $.detail contains No se puede cancelar un pago en estado APROBADO
PATCH {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/cancelar
Authorization: Bearer {{TOKEN_CLIENTE}}

### 2.24 CAJERO no reembolsa (solo ADMIN, 403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "monto": 1.00, "motivo": "prueba" }

### 2.25 Reembolso mayor al saldo disponible (409)
# Esperado: HTTP 409
# @assert $.detail contains supera el saldo disponible
POST {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "monto": 99999.00, "motivo": "prueba" }

### 2.26 Reembolso con monto negativo (400)
# Esperado: HTTP 400
POST {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "monto": -1.00, "motivo": "prueba" }

### 2.27 ADMIN reembolsa S/ 1.00 (REEMBOLSADO_PARCIAL) con Idempotency-Key
# Esperado: HTTP 200
# @assert $.estado == REEMBOLSADO_PARCIAL
# @assert $.montoReembolsado == 1
POST {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Idempotency-Key: {{IDEM_A}}
Content-Type: application/json

{ "monto": 1.00, "motivo": "Reclamo procedente (prueba 04)" }

### 2.28 Repetir la misma Idempotency-Key no reembolsa otra vez
# Esperado: HTTP 200
# @assert $.estado == REEMBOLSADO_PARCIAL
# @assert $.montoReembolsado == 1
POST {{PAYMENTS_URL}}/pagos/{{pagoA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Idempotency-Key: {{IDEM_A}}
Content-Type: application/json

{ "monto": 1.00, "motivo": "Reclamo procedente (prueba 04)" }

### 2.29 Reembolso por orden del saldo restante (REEMBOLSADO)
# Esperado: HTTP 200
# @assert $.estado == REEMBOLSADO
# @assert $.montoReembolsado == {{ordenA.response.body.$.total}}
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "motivo": "Saldo restante (prueba 04)" }

### 2.30 Reembolsar un pago ya REEMBOLSADO con monto (409)
# Esperado: HTTP 409
# @assert $.detail contains Solo se pueden reembolsar pagos APROBADOS
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "monto": 1.00 }

### 2.31 Reembolso por orden sin pago (404)
# Esperado: HTTP 404
POST {{PAYMENTS_URL}}/pagos/orden/{{ORDEN_INEXISTENTE}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "motivo": "no existe" }

### 2.32 Reembolso por orden como CLIENTE (403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenA.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{ "motivo": "no" }

### 2.33 Limpieza: ADMIN cancela la orden A reembolsada
# Esperado: HTTP 200
# @assert $.estado == CANCELADO
PATCH {{ORDERS_URL}}/ordenes/{{ordenA.response.body.$.id}}/estado
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "estado": "CANCELADO" }

###############################################################################
# 3. FLUJO B - cancelar un pago PENDIENTE
###############################################################################

### 3.1 CLIENTE crea orden RECOJO (PENDIENTE_PAGO)
# Esperado: HTTP 201
# @assert $.estado == PENDIENTE_PAGO
# @name ordenB
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{
  "tipo": "RECOJO",
  "nombreCliente": "Cliente Pagos B",
  "telefonoCliente": "{{TEL_A}}",
  "items": [ { "productoId": {{PRODUCTO_ID}}, "cantidad": 1 } ]
}

### 3.2 CAJERO inicia el pago CONTRAENTREGA por el cliente (personal puede)
# Esperado: HTTP 201
# @assert $.estado == PENDIENTE
# @name pagoB
POST {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "ordenId": {{ordenB.response.body.$.id}}, "monto": {{ordenB.response.body.$.total}}, "metodoPago": "CONTRAENTREGA" }

### 3.3 MOZO no cancela pagos (403)
# Esperado: HTTP 403
PATCH {{PAYMENTS_URL}}/pagos/{{pagoB.response.body.$.id}}/cancelar
Authorization: Bearer {{TOKEN_MOZO}}

### 3.4 CLIENTE duenio de la orden cancela el pago PENDIENTE
# Esperado: HTTP 200
# @assert $.estado == CANCELADO
PATCH {{PAYMENTS_URL}}/pagos/{{pagoB.response.body.$.id}}/cancelar
Authorization: Bearer {{TOKEN_CLIENTE}}

### 3.5 Cancelar de nuevo es idempotente
# Esperado: HTTP 200
# @assert $.estado == CANCELADO
PATCH {{PAYMENTS_URL}}/pagos/{{pagoB.response.body.$.id}}/cancelar
Authorization: Bearer {{TOKEN_CAJERO}}

### 3.6 Confirmar un pago CANCELADO (409)
# Esperado: HTTP 409
# @assert $.detail contains Solo se puede confirmar un pago PENDIENTE
PATCH {{PAYMENTS_URL}}/pagos/{{pagoB.response.body.$.id}}/confirmar
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "referenciaExterna": "CAJA-04-B" }

### 3.7 Reembolsar un pago no aprobado (409)
# Esperado: HTTP 409
# @assert $.detail contains Solo se pueden reembolsar pagos APROBADOS
POST {{PAYMENTS_URL}}/pagos/{{pagoB.response.body.$.id}}/reembolso
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "monto": 1.00 }

### 3.8 Cancelar el pago cancela tambien la orden en orders-service
# Esperado: HTTP 200
# @sleep 2000
# @assert $.estado == CANCELADO
GET {{ORDERS_URL}}/ordenes/{{ordenB.response.body.$.id}}
Authorization: Bearer {{TOKEN_ADMIN}}

###############################################################################
# 4. FLUJO C - captura Yape subida por la web y verificada por el personal
###############################################################################

### 4.1 CLIENTE crea orden RECOJO (PENDIENTE_PAGO)
# Esperado: HTTP 201
# @assert $.estado == PENDIENTE_PAGO
# @name ordenC
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: application/json

{
  "tipo": "RECOJO",
  "nombreCliente": "Cliente Pagos C",
  "telefonoCliente": "{{TEL_A}}",
  "items": [ { "productoId": {{PRODUCTO_ID}}, "cantidad": 1 } ]
}

### 4.2 MOZO no sube comprobantes (403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenC.response.body.$.id}}/comprobante
Authorization: Bearer {{TOKEN_MOZO}}
Content-Type: multipart/form-data; boundary=----Pagos04Boundary

------Pagos04Boundary
Content-Disposition: form-data; name="file"; filename="04-comprobante.png"
Content-Type: image/png

< ./fixtures/04-comprobante.png
------Pagos04Boundary--

### 4.3 Comprobante que no es imagen (400)
# Esperado: HTTP 400
# @assert $.detail contains JPG, PNG o WEBP
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenC.response.body.$.id}}/comprobante
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: multipart/form-data; boundary=----Pagos04Boundary

------Pagos04Boundary
Content-Disposition: form-data; name="file"; filename="04-no-imagen.txt"
Content-Type: text/plain

< ./fixtures/04-no-imagen.txt
------Pagos04Boundary--

### 4.4 Comprobante sin la parte "file" (400)
# Esperado: HTTP 400
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenC.response.body.$.id}}/comprobante
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: multipart/form-data; boundary=----Pagos04Boundary

------Pagos04Boundary
Content-Disposition: form-data; name="otro"

nada
------Pagos04Boundary--

### 4.5 Comprobante para una orden inexistente (404)
# Esperado: HTTP 404
POST {{PAYMENTS_URL}}/pagos/orden/{{ORDEN_INEXISTENTE}}/comprobante
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: multipart/form-data; boundary=----Pagos04Boundary

------Pagos04Boundary
Content-Disposition: form-data; name="file"; filename="04-comprobante.png"
Content-Type: image/png

< ./fixtures/04-comprobante.png
------Pagos04Boundary--

### 4.6 CLIENTE sube la captura PNG (PENDIENTE_VERIFICACION, sin clave visible)
# Esperado: HTTP 200
# @assert $.estado == PENDIENTE_VERIFICACION
# @assert $.metodoPago == YAPE_PLIN
# @assert $.comprobanteClave notExists
# @name pagoC
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenC.response.body.$.id}}/comprobante
Authorization: Bearer {{TOKEN_CLIENTE}}
Content-Type: multipart/form-data; boundary=----Pagos04Boundary

------Pagos04Boundary
Content-Disposition: form-data; name="file"; filename="04-comprobante.png"
Content-Type: image/png

< ./fixtures/04-comprobante.png
------Pagos04Boundary--

### 4.7 Bandeja del cajero: pagos PENDIENTE_VERIFICACION
# Esperado: HTTP 200
# @assert $ contains "id":{{pagoC.response.body.$.id}},
GET {{PAYMENTS_URL}}/pagos?estado=PENDIENTE_VERIFICACION
Authorization: Bearer {{TOKEN_CAJERO}}

### 4.8 CAJERO ve la URL firmada del comprobante
# Esperado: HTTP 200
# @assert $.comprobanteClave exists
# @assert $.comprobanteUrl exists
GET {{PAYMENTS_URL}}/pagos/{{pagoC.response.body.$.id}}
Authorization: Bearer {{TOKEN_CAJERO}}

### 4.9 CLIENTE no ve la clave ni la URL del comprobante
# Esperado: HTTP 200
# @assert $.comprobanteClave notExists
# @assert $.comprobanteUrl notExists
GET {{PAYMENTS_URL}}/pagos/{{pagoC.response.body.$.id}}
Authorization: Bearer {{TOKEN_CLIENTE}}

### 4.10 MOZO no verifica comprobantes (403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos/{{pagoC.response.body.$.id}}/verificar
Authorization: Bearer {{TOKEN_MOZO}}
Content-Type: application/json

{ "aprobado": true }

### 4.11 Verificar sin "aprobado" (400)
# Esperado: HTTP 400
POST {{PAYMENTS_URL}}/pagos/{{pagoC.response.body.$.id}}/verificar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "motivoRechazo": "x" }

### 4.12 Rechazar sin motivo (400)
# Esperado: HTTP 400
# @assert $.detail contains motivo de rechazo es obligatorio
POST {{PAYMENTS_URL}}/pagos/{{pagoC.response.body.$.id}}/verificar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "aprobado": false }

