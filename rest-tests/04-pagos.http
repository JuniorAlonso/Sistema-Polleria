Authorization: Bearer {{TOKEN_REPARTIDOR}}

### 7.18 Efectivo pendiente con clave interna (finance-service)
# Esperado: HTTP 200
# @assert $.repartidorId == {{reclamoH.response.body.$.repartidorId}}
GET {{PAYMENTS_URL}}/pagos/efectivo/repartidor/{{reclamoH.response.body.$.repartidorId}}
X-Internal-Key: {{INTERNAL_KEY}}

### 7.19 CLIENTE no consulta efectivo de repartidores (403)
# Esperado: HTTP 403
GET {{PAYMENTS_URL}}/pagos/efectivo/repartidor/{{reclamoH.response.body.$.repartidorId}}
Authorization: Bearer {{TOKEN_CLIENTE}}

### 7.20 REPARTIDOR no liquida efectivo (403)
# Esperado: HTTP 403
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_REPARTIDOR}}
Content-Type: application/json

{ "pagoIds": [ {{cobroH.response.body.$.id}} ], "liquidacionId": {{LIQ_ID}} }

### 7.21 Liquidar sin pagoIds (400)
# Esperado: HTTP 400
# @assert $.detail contains pagoIds es obligatorio
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "pagoIds": [], "liquidacionId": {{LIQ_ID}} }

### 7.22 Liquidar un pago inexistente (404)
# Esperado: HTTP 404
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "pagoIds": [ {{PAGO_INEXISTENTE}} ], "liquidacionId": {{LIQ_ID}} }

### 7.23 Liquidar un pago que no es efectivo aprobado (409)
# Esperado: HTTP 409
# @assert $.detail contains no es un cobro en efectivo aprobado
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "pagoIds": [ {{pagoC.response.body.$.id}} ], "liquidacionId": {{LIQ_ID}} }

### 7.24 CAJERO liquida el efectivo del repartidor
# Esperado: HTTP 200
# @assert $.liquidados == 1
# @assert $.liquidacionId == {{LIQ_ID}}
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "pagoIds": [ {{cobroH.response.body.$.id}} ], "liquidacionId": {{LIQ_ID}} }

### 7.25 Liquidar de nuevo en la misma liquidacion es idempotente
# Esperado: HTTP 200
# @assert $.liquidados == 1
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "pagoIds": [ {{cobroH.response.body.$.id}} ], "liquidacionId": {{LIQ_ID}} }

### 7.26 El mismo pago no se liquida en otra liquidacion (409)
# Esperado: HTTP 409
# @assert $.detail contains ya fue liquidado
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: application/json

{ "pagoIds": [ {{cobroH.response.body.$.id}} ], "liquidacionId": {{LIQ_OTRA}} }

### 7.27 Liquidar con clave interna (finance-service), idempotente
# Esperado: HTTP 200
# @assert $.liquidados == 1
POST {{PAYMENTS_URL}}/pagos/efectivo/liquidar
X-Internal-Key: {{INTERNAL_KEY}}
Content-Type: application/json

{ "pagoIds": [ {{cobroH.response.body.$.id}} ], "liquidacionId": {{LIQ_ID}} }

### 7.28 Subir comprobante a una orden ENTREGADA (409)
# Esperado: HTTP 409
# @assert $.detail contains ya no admite comprobantes
POST {{PAYMENTS_URL}}/pagos/orden/{{ordenH.response.body.$.id}}/comprobante
Authorization: Bearer {{TOKEN_ADMIN}}
Content-Type: multipart/form-data; boundary=----Pagos04Boundary

------Pagos04Boundary
Content-Disposition: form-data; name="file"; filename="04-comprobante.png"
Content-Type: image/png

< ./fixtures/04-comprobante.png
------Pagos04Boundary--

###############################################################################
# 8. LISTADO GENERAL (ADMIN / CAJERO)
###############################################################################

### 8.1 ADMIN lista todos los pagos
# Esperado: HTTP 200
# @assert $ contains "id":{{cobroH.response.body.$.id}},
GET {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_ADMIN}}

### 8.2 CAJERO filtra por estado y limite
# Esperado: HTTP 200
# @assert $[0].estado == APROBADO
GET {{PAYMENTS_URL}}/pagos?estado=APROBADO&limit=5
Authorization: Bearer {{TOKEN_CAJERO}}

### 8.3 CAJERO filtra por fecha de hoy
# Esperado: HTTP 200
# @assert $ contains "id":{{cobroH.response.body.$.id}},
GET {{PAYMENTS_URL}}/pagos?fecha={{$localDatetime 'YYYY-MM-DD'}}
Authorization: Bearer {{TOKEN_CAJERO}}

### 8.4 Estado invalido en el filtro (400)
# Esperado: HTTP 400
GET {{PAYMENTS_URL}}/pagos?estado=NO_EXISTE
Authorization: Bearer {{TOKEN_ADMIN}}

### 8.5 CLIENTE no lista todos los pagos (403)
# Esperado: HTTP 403
GET {{PAYMENTS_URL}}/pagos
Authorization: Bearer {{TOKEN_CLIENTE}}

### 8.6 Sin token no se listan pagos (403)
# Esperado: HTTP 403
GET {{PAYMENTS_URL}}/pagos
