  "nombreCliente": "Cliente Pagos H",
  "telefonoCliente": "{{TEL_H}}",
  "estadoInicial": "PENDIENTE_CONFIRMACION",
  "requiereCobroEfectivo": true,
  "items": [ { "productoId": {{PRODUCTO_ID}}, "cantidad": 1 } ]
}

