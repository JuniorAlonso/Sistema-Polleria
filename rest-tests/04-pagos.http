POST {{PAYMENTS_URL}}/pagos/{{pagoC.response.body.$.id}}/verificar
Authorization: Bearer {{TOKEN_CAJERO}}
Content-Type: application/json

{ "aprobado": false, "motivoRechazo": "La captura no muestra el monto (prueba 04)" }

