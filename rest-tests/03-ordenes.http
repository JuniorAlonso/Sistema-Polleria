POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "tipo": "RECOJO", "estadoInicial": "RECIBIDO", "nombreCliente": "QA", "telefonoCliente": "987000001", "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### 1.6 Cantidad 0: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "tipo": "RECOJO", "nombreCliente": "QA", "telefonoCliente": "987000001", "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 0 } ] }

### 1.7 Producto inexistente: 404
# Esperado: HTTP 404
POST {{ORDERS_URL}}/ordenes
