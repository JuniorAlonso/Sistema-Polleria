# @otp OTP_REPARTIDOR repartidor.polleria@yopmail.com
# @assert $.role == REPARTIDOR
# @name loginRepartidor
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "repartidor.polleria@yopmail.com", "code": "{{OTP_REPARTIDOR}}" }

### 0.10 Login CAJERO - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "cajero.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.11 Login CAJERO - paso 2
# Esperado: HTTP 200
