POST {{ORDERS_URL}}/ordenes/{{comandaSalon.response.body.$.id}}/servir
Authorization: Bearer {{loginMozo.response.body.$.token}}

### A.34 Estado terminal no cambia (ENTREGADO -> CANCELADO): 400
# Esperado: HTTP 400
PATCH {{ORDERS_URL}}/ordenes/{{comandaSalon.response.body.$.id}}/estado
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "estado": "CANCELADO" }

###############################################################################
# B. DELIVERY CONTRAENTREGA (ContraPago con confirmacion de llamada)
###############################################################################

### B.1 Invitado crea DELIVERY ContraPago: PENDIENTE_CONFIRMACION, vuelto estimado
# Esperado: HTTP 201
# @assert $.estado == PENDIENTE_CONFIRMACION
# @assert $.canalOrigen == WEB
# @assert $.requiereCobroEfectivo == true
# @assert $.clienteId == 0
# @assert $.total >= 24.51
# @assert $.vueltoEstimado exists
# @name ordenDelivery
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "tipo": "DELIVERY", "estadoInicial": "PENDIENTE_CONFIRMACION", "direccionEntrega": "Av. QA Delivery 100", "referencia": "Puerta azul", "nombreCliente": "QA Delivery", "telefonoCliente": "{{TEL_DELIVERY}}", "montoPagaCon": 200, "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### B.2 Anonimo no ve la orden por id: 404 (anti-enumeracion)
# Esperado: HTTP 404
GET {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}

### B.3 CLIENTE ajeno no ve la orden: 404
# Esperado: HTTP 404
GET {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}

### B.4 Servicio con clave interna ve la orden
# Esperado: HTTP 200
# @assert $.id == {{ordenDelivery.response.body.$.id}}
GET {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}
X-Internal-Key: {{INTERNAL_KEY}}

### B.5 Clave interna incorrecta: 404
# Esperado: HTTP 404
GET {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}
X-Internal-Key: clave-incorrecta

### B.6 Personal (CAJERO) ve la orden
# Esperado: HTTP 200
# @assert $.telefonoCliente == {{ordenDelivery.response.body.$.telefonoCliente}}
GET {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}
Authorization: Bearer {{loginCajero.response.body.$.token}}

### B.7 Orden inexistente: 404
# Esperado: HTTP 404
GET {{ORDERS_URL}}/ordenes/999999999
Authorization: Bearer {{loginCajero.response.body.$.token}}

### B.8 Activas por telefono sin clave interna: 403
# Esperado: HTTP 403
GET {{ORDERS_URL}}/ordenes/activas-por-telefono?telefono={{ordenDelivery.response.body.$.telefonoCliente}}

### B.9 Activas por telefono con clave interna (bot WhatsApp) incluye la orden
# Esperado: HTTP 200
# @assert $[0].id == {{ordenDelivery.response.body.$.id}}
GET {{ORDERS_URL}}/ordenes/activas-por-telefono?telefono=51{{ordenDelivery.response.body.$.telefonoCliente}}
X-Internal-Key: {{INTERNAL_KEY}}

### B.10 Activas por telefono con celular invalido: 400
# Esperado: HTTP 400
GET {{ORDERS_URL}}/ordenes/activas-por-telefono?telefono=12345
X-Internal-Key: {{INTERNAL_KEY}}

### B.11 COCINA no puede saltarse la llamada: 409
# Esperado: HTTP 409
PATCH {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}/estado
Authorization: Bearer {{loginCocina.response.body.$.token}}
Content-Type: application/json

{ "estado": "EN_PREPARACION" }

### B.12 Intento de llamada por REPARTIDOR: 403
# Esperado: HTTP 403
POST {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}/intento-llamada
Authorization: Bearer {{loginRepartidor.response.body.$.token}}
Content-Type: application/json

{ "observaciones": "no contesta" }

### B.13 CAJERO registra 1er intento fallido: sigue PENDIENTE_CONFIRMACION
