###############################################################################
# A. FLUJO SALON
###############################################################################

### A.1 ADMIN crea una mesa propia con numero alto
# Esperado: HTTP 201
# @assert $.estado == LIBRE
# @name mesaQa
POST {{ORDERS_URL}}/mesas
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{ "numero": {{MESA_NUM}}, "capacidad": 4, "posicionX": 5, "posicionY": 5 }

### A.2 Anonimo no puede abrir comanda de salon: 403
# Esperado: HTTP 403
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "tipo": "SALON", "mesaId": {{mesaQa.response.body.$.id}}, "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### A.3 CLIENTE no puede abrir comanda de salon: 403
# Esperado: HTTP 403
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{loginCliente.response.body.$.token}}
Content-Type: application/json

{ "tipo": "SALON", "mesaId": {{mesaQa.response.body.$.id}}, "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### A.4 SALON sin mesa: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{loginMozo.response.body.$.token}}
Content-Type: application/json

{ "tipo": "SALON", "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### A.5 SALON con mesa inexistente: 404
# Esperado: HTTP 404
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{loginMozo.response.body.$.token}}
Content-Type: application/json

{ "tipo": "SALON", "mesaId": 999999999, "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### A.6 MOZO abre la comanda: RECIBIDO, mesa OCUPADA, canal SALON
# Esperado: HTTP 201
# @assert $.tipo == SALON
# @assert $.estado == RECIBIDO
# @assert $.canalOrigen == SALON
# @assert $.mesaEstado == OCUPADA
# @assert $.mozoId exists
# @assert $.total == 24.5
# @name comandaSalon
POST {{ORDERS_URL}}/ordenes
Authorization: Bearer {{loginMozo.response.body.$.token}}
Content-Type: application/json

{ "tipo": "SALON", "mesaId": {{mesaQa.response.body.$.id}}, "observaciones": "QA comanda", "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1, "notas": "sin aji" } ] }

