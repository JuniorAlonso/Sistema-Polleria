###############################################################################
# 03 - ORDENES (orders-service: OrdenController + SeguimientoController)
# Extension: REST Client (humao.rest-client). Runner: node runner/run-http.mjs 03-ordenes.http
#
# Flujos cubiertos de punta a punta:
#   A. SALON: mesa propia -> comanda -> segunda ronda -> cocina -> LISTO -> servir
#      -> nueva ronda (vuelve a cocina) -> POR_COBRAR -> cierre por CAJERO -> mesa LIBRE
#   B. DELIVERY contraentrega: intento de llamada -> confirmar llamada -> cocina -> LISTO
#      -> reclamo del repartidor -> EN_CAMINO -> EN_PUERTA -> ENTREGADO (tras el cobro)
#   C. ContraPago con 2 intentos fallidos de llamada -> CANCELADO automatico
#   D. RECOJO de cliente registrado: comprobante -> pago aprobado -> cocina -> ticket POL-<id>
#   E. Cancelacion por el cliente dueno
#   F. Pedido fantasma (DELIVERY) y sancion del celular para ContraPago
#   G. Seguimiento sin cuenta (codigo por WhatsApp) y cancelacion del invitado
#
# Datos: usa productos sembrados SIN control de stock (id 1 y 9), crea su propia mesa con un
# numero alto aleatorio (se da de baja al final) y celulares aleatorios 9XXXXXXXX por corrida.
# La sancion del flujo F solo afecta a su celular desechable: la orden no lleva ipOrigen ni
# clienteId, asi que no se bloquea ninguna IP ni correo.
#
# Clave interna: {{$dotenv INTERNAL_API_KEY}} simula a payments-service / bot de WhatsApp.
# 2FA: en REST Client copia el codigo en @OTP_*. El runner lo lee con "# @otp".
# Seguimiento: el codigo que el cliente recibe por WhatsApp se lee con "# @sql" (codigos_seguimiento).
###############################################################################

@AUTH_URL = http://localhost:8081
@ORDERS_URL = http://localhost:8082
@PASSWORD = Password123!
@INTERNAL_KEY = {{$dotenv INTERNAL_API_KEY}}

@OTP_ADMIN = 000000
@OTP_MOZO = 000000
@OTP_COCINA = 000000
@OTP_REPARTIDOR = 000000
@OTP_CAJERO = 000000

@PRODUCTO_POLLO = 1
@PRODUCTO_CHICHA = 9

@MESA_NUM = {{$randomInt 90000 99999}}
@TEL_DELIVERY = 9{{$randomInt 10000000 99999999}}
@TEL_INTENTOS = 9{{$randomInt 10000000 99999999}}
@TEL_FANTASMA = 9{{$randomInt 10000000 99999999}}
@TEL_SEGUIMIENTO = 9{{$randomInt 10000000 99999999}}

###############################################################################
# 0. SESIONES
###############################################################################

### 0.1 Login CLIENTE (sin 2FA)
# Esperado: HTTP 200
# @assert $.token exists
# @name loginCliente
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "cliente.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.2 Login ADMIN - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "admin.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.3 Login ADMIN - paso 2
# Esperado: HTTP 200
# @otp OTP_ADMIN admin.polleria@yopmail.com
# @assert $.role == ADMIN
# @name loginAdmin
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "admin.polleria@yopmail.com", "code": "{{OTP_ADMIN}}" }

### 0.4 Login MOZO - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "mozo.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.5 Login MOZO - paso 2
# Esperado: HTTP 200
# @otp OTP_MOZO mozo.polleria@yopmail.com
# @assert $.role == MOZO
# @name loginMozo
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "mozo.polleria@yopmail.com", "code": "{{OTP_MOZO}}" }

### 0.6 Login COCINA - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "cocina.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.7 Login COCINA - paso 2
# Esperado: HTTP 200
# @otp OTP_COCINA cocina.polleria@yopmail.com
# @assert $.role == COCINA
# @name loginCocina
POST {{AUTH_URL}}/auth/verify-2fa
Content-Type: application/json

{ "email": "cocina.polleria@yopmail.com", "code": "{{OTP_COCINA}}" }

### 0.8 Login REPARTIDOR - paso 1
# Esperado: HTTP 200
# @assert $.requiresTwoFactor == true
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{ "identifier": "repartidor.polleria@yopmail.com", "password": "{{PASSWORD}}" }

### 0.9 Login REPARTIDOR - paso 2
