# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes/seguimiento/verificar
Content-Type: application/json

{ "telefono": "{{ordenSeguimiento.response.body.$.telefonoCliente}}", "codigo": "abcdef" }

### G.6 Verificar con el codigo recibido por WhatsApp: token de acceso
# Esperado: HTTP 200
# @sql COD_SEGUIMIENTO SELECT codigo FROM codigos_seguimiento WHERE telefono = '{{ordenSeguimiento.response.body.$.telefonoCliente}}' AND usado = false ORDER BY creado_en DESC LIMIT 1
# @assert $.token exists
# @name accesoSeguimiento
POST {{ORDERS_URL}}/ordenes/seguimiento/verificar
Content-Type: application/json

{ "telefono": "{{ordenSeguimiento.response.body.$.telefonoCliente}}", "codigo": "{{COD_SEGUIMIENTO}}" }

### G.7 El codigo usado ya no sirve: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes/seguimiento/verificar
Content-Type: application/json

{ "telefono": "{{ordenSeguimiento.response.body.$.telefonoCliente}}", "codigo": "{{COD_SEGUIMIENTO}}" }

### G.8 Listar pedidos con el acceso temporal
# Esperado: HTTP 200
# @assert $[0].id == {{ordenSeguimiento.response.body.$.id}}
GET {{ORDERS_URL}}/ordenes/seguimiento
X-Seguimiento-Token: {{accesoSeguimiento.response.body.$.token}}

### G.9 Listar sin header: 400
# Esperado: HTTP 400
GET {{ORDERS_URL}}/ordenes/seguimiento

### G.10 Listar con token alterado: 400
# Esperado: HTTP 400
GET {{ORDERS_URL}}/ordenes/seguimiento
X-Seguimiento-Token: token-falso

### G.11 Un JWT de sesion no sirve como acceso de seguimiento: 400
# Esperado: HTTP 400
GET {{ORDERS_URL}}/ordenes/seguimiento
X-Seguimiento-Token: {{loginCliente.response.body.$.token}}

### G.12 Cancelar un pedido de otro celular: 404
# Esperado: HTTP 404
POST {{ORDERS_URL}}/ordenes/seguimiento/{{ordenDelivery.response.body.$.id}}/cancelar
X-Seguimiento-Token: {{accesoSeguimiento.response.body.$.token}}

### G.13 Cancelar sin token: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes/seguimiento/{{ordenSeguimiento.response.body.$.id}}/cancelar

### G.14 El invitado cancela su pedido
# Esperado: HTTP 200
# @assert $.estado == CANCELADO
POST {{ORDERS_URL}}/ordenes/seguimiento/{{ordenSeguimiento.response.body.$.id}}/cancelar
X-Seguimiento-Token: {{accesoSeguimiento.response.body.$.token}}

### G.15 Cancelar otra vez es idempotente
# Esperado: HTTP 200
# @assert $.estado == CANCELADO
POST {{ORDERS_URL}}/ordenes/seguimiento/{{ordenSeguimiento.response.body.$.id}}/cancelar
X-Seguimiento-Token: {{accesoSeguimiento.response.body.$.token}}

###############################################################################
# H. LISTADOS DEL PERSONAL
###############################################################################

### H.1 Listado por defecto (activos + completados hoy) incluye la comanda cerrada
# Esperado: HTTP 200
# @assert $ contains "id":{{comandaSalon.response.body.$.id}},
GET {{ORDERS_URL}}/ordenes
Authorization: Bearer {{loginCajero.response.body.$.token}}

### H.2 Solo activos
# Esperado: HTTP 200
GET {{ORDERS_URL}}/ordenes?soloActivos=true
Authorization: Bearer {{loginRepartidor.response.body.$.token}}

### H.3 Filtro por estado CANCELADO incluye la cancelada por el cliente
# Esperado: HTTP 200
# @assert $ contains "id":{{ordenCancelable.response.body.$.id}},
GET {{ORDERS_URL}}/ordenes?estado=CANCELADO
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### H.4 Filtro con estado invalido: 400
# Esperado: HTTP 400
GET {{ORDERS_URL}}/ordenes?estado=VOLANDO
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### H.5 Listado por CLIENTE: 403
# Esperado: HTTP 403
GET {{ORDERS_URL}}/ordenes
Authorization: Bearer {{loginCliente.response.body.$.token}}

### H.6 Listado anonimo: 403
# Esperado: HTTP 403
GET {{ORDERS_URL}}/ordenes

###############################################################################
# Z. LIMPIEZA
###############################################################################

### Z.1 ADMIN da de baja la mesa propia (ya LIBRE)
# Esperado: HTTP 204
DELETE {{ORDERS_URL}}/mesas/{{mesaQa.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
