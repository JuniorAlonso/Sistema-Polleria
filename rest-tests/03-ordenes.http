POST {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}/intento-llamada
Authorization: Bearer {{loginCajero.response.body.$.token}}
Content-Type: application/json

{ "observaciones": "no contesta" }

### B.14 Confirmar llamada por MOZO: 403
# Esperado: HTTP 403
POST {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}/confirmar-llamada
Authorization: Bearer {{loginMozo.response.body.$.token}}

### B.15 CAJERO confirma la llamada: entra a la cola de cocina (RECIBIDO)
# Esperado: HTTP 200
# @assert $.estado == RECIBIDO
POST {{ORDERS_URL}}/ordenes/{{ordenDelivery.response.body.$.id}}/confirmar-llamada
Authorization: Bearer {{loginCajero.response.body.$.token}}

### B.16 Confirmar otra vez: 409
# Esperado: HTTP 409
