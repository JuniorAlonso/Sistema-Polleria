# 1. VALIDACIONES DE CREACION (POST /ordenes)
###############################################################################

### 1.1 Sin productos: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "tipo": "RECOJO", "nombreCliente": "QA", "telefonoCliente": "987000001", "items": [] }

### 1.2 Sin tipo: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "nombreCliente": "QA", "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### 1.3 DELIVERY sin direccion: 400
# Esperado: HTTP 400
POST {{ORDERS_URL}}/ordenes
Content-Type: application/json

{ "tipo": "DELIVERY", "nombreCliente": "QA", "telefonoCliente": "987000001", "items": [ { "productoId": {{PRODUCTO_POLLO}}, "cantidad": 1 } ] }

### 1.4 Estado inicial no permitido (EN_PREPARACION): 400
