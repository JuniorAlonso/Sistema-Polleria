POST {{FINANCE_URL}}/finanzas/liquidaciones/{{LIQ_B}}/cierre
Authorization: Bearer {{TK_ADMIN}}
Content-Type: application/json

{ "totalRendido": 15 }

###############################################################################
# 7. BALANCE DIARIO
###############################################################################

### 7.1 ADMIN consulta el balance de hoy
# Esperado: HTTP 200
# @assert $.fecha exists
# @assert $.ingresos.totalIngresos exists
# @assert $.egresos.totalEgresos exists
# @assert $.balanceNeto exists
GET {{FINANCE_URL}}/finanzas/balance/diario
Authorization: Bearer {{TK_ADMIN}}

### 7.2 Balance de una fecha sin operaciones
# Esperado: HTTP 200
# @assert $.fecha == 2000-01-01
# @assert $.ordenesAtendidas == 0
GET {{FINANCE_URL}}/finanzas/balance/diario?fecha=2000-01-01
Authorization: Bearer {{TK_ADMIN}}

### 7.3 CAJERO no ve el balance (solo ADMIN)
# Esperado: HTTP 403
GET {{FINANCE_URL}}/finanzas/balance/diario
Authorization: Bearer {{TK_CAJERO}}

### 7.4 Anonimo no ve el balance (403)
# Esperado: HTTP 403
GET {{FINANCE_URL}}/finanzas/balance/diario

###############################################################################
# 8. CIERRE DE CAJA (arqueo ciego) E HISTORIAL
###############################################################################

### 8.1 Cierre sin monto POS es rechazado (400)
# Esperado: HTTP 400
POST {{FINANCE_URL}}/finanzas/caja/cierre
Authorization: Bearer {{TK_CAJERO}}
Content-Type: application/json

{ "montoCierreEfectivo": 0 }

### 8.2 Cierre con diferencia y sin observaciones (arqueo ciego) es rechazado (400)
# Esperado: HTTP 400
POST {{FINANCE_URL}}/finanzas/caja/cierre
Authorization: Bearer {{TK_CAJERO}}
Content-Type: application/json

{ "montoCierreEfectivo": 0, "montoCierrePos": 0 }

### 8.3 COCINA no cierra la caja (403)
# Esperado: HTTP 403
POST {{FINANCE_URL}}/finanzas/caja/cierre
Authorization: Bearer {{TK_COCINA}}
Content-Type: application/json

{ "montoCierreEfectivo": 0, "montoCierrePos": 0, "observaciones": "No autorizado" }

### 8.4 CAJERO cierra su caja con faltante justificado
# Esperado: HTTP 200
# @assert $.id == {{CAJA_ID}}
# @assert $.estado == CERRADA
# @assert $.totalEsperado >= 100
# @assert $.diferencia <= -100
# @assert $.observaciones == Faltante justificado suite 05
POST {{FINANCE_URL}}/finanzas/caja/cierre?arqueoId={{CAJA_ID}}
Authorization: Bearer {{TK_CAJERO}}
Content-Type: application/json

{ "montoCierreEfectivo": 0, "montoCierrePos": 0, "ventasDigitales": 0, "observaciones": "Faltante justificado suite 05" }

### 8.5 Cerrar otra vez la misma caja (409)
# Esperado: HTTP 409
POST {{FINANCE_URL}}/finanzas/caja/cierre?arqueoId={{CAJA_ID}}
Authorization: Bearer {{TK_ADMIN}}
Content-Type: application/json

{ "montoCierreEfectivo": 0, "montoCierrePos": 0, "observaciones": "Repetido" }

### 8.6 Cerrar un arqueo inexistente (404)
# Esperado: HTTP 404
POST {{FINANCE_URL}}/finanzas/caja/cierre?arqueoId={{ORDEN_INEXISTENTE}}
Authorization: Bearer {{TK_ADMIN}}
Content-Type: application/json

{ "montoCierreEfectivo": 0, "montoCierrePos": 0 }

### 8.7 Ya no queda caja abierta
# Esperado: HTTP 404
GET {{FINANCE_URL}}/finanzas/caja/actual
Authorization: Bearer {{TK_CAJERO}}

### 8.8 ADMIN ve la caja cerrada en el historial
# Esperado: HTTP 200
# @assert $ contains "id":{{CAJA_ID}},"usuarioId":
# @assert $ contains Faltante justificado suite 05
GET {{FINANCE_URL}}/finanzas/caja/historial
Authorization: Bearer {{TK_ADMIN}}
