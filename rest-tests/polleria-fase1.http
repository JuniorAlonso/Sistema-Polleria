###############################################################################
# SISTEMA POLLERÍA - FASE 1 (TESTS MULTI-NIVEL)
# Extensión: REST Client (humao.rest-client)
###############################################################################

# Variables de URLs de Microservicios (AWS EC2)
@AUTH_URL = http://98.86.149.179:8081
@ORDERS_URL = http://100.53.223.167:8082
@PAYMENTS_URL = http://44.203.62.89:8083
@NOTIF_URL = http://100.53.223.167:3001

# Tokens extraídos dinámicamente de las respuestas de login
@TOKEN_ADMIN = {{loginAdmin.response.body.token}}
@TOKEN_CLIENTE = {{loginCliente.response.body.token}}
@TOKEN_MOZO = {{loginMozo.response.body.token}}
@TOKEN_COCINA = {{loginCocina.response.body.token}}
@TOKEN_REPARTIDOR = {{loginRepartidor.response.body.token}}

# IDs extraídos dinámicamente de las creaciones
@PRODUCTO_ID = {{createProduct.response.body.id}}
@MESA_ID = {{createMesa.response.body.id}}
@ORDEN_ID = {{createOrder.response.body.id}}
@PAGO_ID = {{createPayment.response.body.id}}


================================================================================
# 1. NIVEL 1 - SMOKE & HEALTH TESTS
================================================================================

### 1.1 Health Check - Notification Service
# Esperado: HTTP 200
GET {{NOTIF_URL}}/status

### 1.2 Catalogo Publico - Orders Service
# Esperado: HTTP 200
GET {{ORDERS_URL}}/productos

### 1.3 Endpoint Protegido Sin Token - Auth Validate (401)
# Esperado: HTTP 401
GET {{AUTH_URL}}/auth/validate

### 1.4 Endpoint Protegido Sin Token - Payments (401)
# Esperado: HTTP 401
GET {{PAYMENTS_URL}}/pagos


================================================================================
# 2. NIVEL 2 - HAPPY PATH & FLUJO E2E
================================================================================


------------------------------------------------------------
# 2.1 Autenticacion Multi-Rol (5 Roles)
------------------------------------------------------------

### 2.1.1 Registrar Usuario ADMIN
# Esperado: HTTP 201
POST {{AUTH_URL}}/auth/register
Content-Type: application/json

{
  "name": "Admin Polleria",
  "email": "admin@sanpollo.com",
  "phone": "987654321",
  "password": "admin123",
  "role": "ADMIN"
}

### 2.1.2 Login ADMIN (Guarda TOKEN_ADMIN y TOKEN)
# Esperado: HTTP 200
# @name loginAdmin
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{
  "identifier": "admin@sanpollo.com",
  "password": "admin123"
}

### 2.1.3 Registrar Usuario CLIENTE
# Esperado: HTTP 201
POST {{AUTH_URL}}/auth/register
Content-Type: application/json

{
  "name": "Juan Cliente",
  "email": "cliente@sanpollo.com",
  "phone": "912345678",
  "password": "cliente123",
  "role": "CLIENTE"
}

### 2.1.4 Login CLIENTE (Guarda TOKEN_CLIENTE y TOKEN)
# Esperado: HTTP 200
# @name loginCliente
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{
  "identifier": "cliente@sanpollo.com",
  "password": "cliente123"
}

### 2.1.5 Registrar Usuario MOZO
# Esperado: HTTP 201
POST {{AUTH_URL}}/auth/register
Content-Type: application/json

{
  "name": "Carlos Mozo",
  "email": "mozo@sanpollo.com",
  "phone": "922334455",
  "password": "mozo123",
  "role": "MOZO"
}

### 2.1.6 Login MOZO (Guarda TOKEN_MOZO y TOKEN)
# Esperado: HTTP 200
# @name loginMozo
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{
  "identifier": "mozo@sanpollo.com",
  "password": "mozo123"
}

### 2.1.7 Registrar Usuario COCINA
# Esperado: HTTP 201
POST {{AUTH_URL}}/auth/register
Content-Type: application/json

{
  "name": "Chef Mario Cocina",
  "email": "cocina@sanpollo.com",
  "phone": "933445566",
  "password": "cocina123",
  "role": "COCINA"
}

### 2.1.8 Login COCINA (Guarda TOKEN_COCINA y TOKEN)
# Esperado: HTTP 200
# @name loginCocina
POST {{AUTH_URL}}/auth/login
Content-Type: application/json

{
  "identifier": "cocina@sanpollo.com",
  "password": "cocina123"
