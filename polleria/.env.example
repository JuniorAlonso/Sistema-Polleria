# ==============================================================================
# SISTEMA POLLERÍA - VARIABLES DE DESARROLLO LOCAL (docker-compose.local.yml)
# ==============================================================================
# Copia este archivo a polleria/.env y define credenciales locales seguras.
# NUNCA subas .env a git.
# ==============================================================================

# Base de datos PostgreSQL y pgAdmin
POSTGRES_DB=polleria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_postgres_password_local
PGADMIN_DEFAULT_EMAIL=admin@polleria.com
PGADMIN_DEFAULT_PASSWORD=cambia_pgadmin_password_local

# JWT y claves internas compartidas entre microservicios
JWT_SECRET=cambia_jwt_secret_local_de_alta_entropia_min_32_chars
JWT_EXPIRATION_MS=900000
INTERNAL_API_KEY=cambia_internal_api_key_local
NOTIFICATION_API_KEY=cambia_notification_api_key_local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost

# Correo SMTP para 2FA (opcional en dev)
MAIL_USERNAME=
MAIL_PASSWORD=

# Mercado Pago (opcional en sandbox local)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true

# MinIO (S3 local)
MINIO_ROOT_USER=cambia_minio_user_local
MINIO_ROOT_PASSWORD=cambia_minio_password_local
MINIO_BUCKET_CATALOGO=polleria-catalogo
MINIO_BUCKET_FEEDBACK=polleria-feedback
MINIO_BUCKET_COMPROBANTES=polleria-comprobantes

# Facturación electrónica SUNAT (Beta por defecto)
SUNAT_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_USUARIO_SOL=MODDATOS
SUNAT_CLAVE_SOL=moddatos
SUNAT_CERT_PASSWORD=cambia_cert_password_local
SUNAT_CERT_BASE64=
SUNAT_FIRMA_ALGORITMO=SHA1
SUNAT_RUC=20608945123
SUNAT_RAZON_SOCIAL=POLLERIA SAN POLLO DE ICA S.A.C.
SUNAT_NOMBRE_COMERCIAL=POLLERIA SAN POLLO DE ICA
SUNAT_DIRECCION=AV. SAN MARTIN 456
SUNAT_UBIGEO=110101
SUNAT_DEPARTAMENTO=ICA
SUNAT_PROVINCIA=ICA
SUNAT_DISTRITO=ICA
