# ==============================================================================
# SISTEMA POLLERÍA - PLANTILLA DE VARIABLES DE PRODUCCIÓN (GCP CLOUD RUN)
# ==============================================================================
# IMPORTANTE: En producción pasa los secretos vía Google Secret Manager
# (--set-secrets en deploy-gcp-cloudrun.ps1), nunca versionados ni en claro.
# ==============================================================================

# 1. Configuración de GCP Project y Región
GCP_PROJECT_ID=tu-proyecto-gcp-id
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=polleria-repo

# 2. Base de Datos (Cloud SQL PostgreSQL o AWS RDS)
DB_URL=jdbc:postgresql://<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require
DB_USERNAME=postgres_user
DB_PASSWORD=TU_PASSWORD_SEGURO_AQUI
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require

# 3. Seguridad, JWT y Claves Internas entre Servicios
JWT_SECRET=GENERA_UNA_CLAVE_DE_ALTA_ENTROPIA_DE_MINIMO_32_CARACTERES
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
INTERNAL_API_KEY=GENERA_UNA_CLAVE_INTERNA_ALEATORIA_SEGURA
NOTIFICATION_API_KEY=GENERA_UNA_CLAVE_NOTIFICACIONES_ALEATORIA_SEGURA

# 4. Orígenes Permitidos (CORS - URL de tu Frontend)
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,https://polleria.tu-dominio.com

# 5. Pasarela de Pagos (Mercado Pago Producción)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-TU_ACCESS_TOKEN_PRODUCCION
MERCADOPAGO_WEBHOOK_SECRET=TU_WEBHOOK_SECRET_PRODUCCION
MERCADOPAGO_SANDBOX=false

# 6. Servicio de Correo (SMTP / 2FA)
MAIL_USERNAME=notificaciones@tu-dominio.com
MAIL_PASSWORD=TU_APP_PASSWORD_SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# 7. Almacenamiento de Objetos S3 / MinIO
MINIO_ENDPOINT=minio.tu-dominio.com
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=TU_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=TU_MINIO_SECRET_KEY
MINIO_BUCKET=polleria-comprobantes
MINIO_BUCKET_CATALOGO=polleria-catalogo
MINIO_BUCKET_FEEDBACK=polleria-feedback

# 8. URLs de Microservicios Inter-servicio en Cloud Run
AUTH_SERVICE_URL=https://auth-service-xxxx-uc.a.run.app
ORDERS_SERVICE_URL=https://orders-service-xxxx-uc.a.run.app
PAYMENTS_SERVICE_URL=https://payments-service-xxxx-uc.a.run.app
FEEDBACK_SERVICE_URL=https://feedback-service-xxxx-uc.a.run.app
FINANCE_SERVICE_URL=https://finance-service-xxxx-uc.a.run.app
INCIDENT_SERVICE_URL=https://incident-service-xxxx-uc.a.run.app
FACTURACION_SUNAT_SERVICE_URL=https://facturacion-sunat-service-xxxx-uc.a.run.app
NOTIFICATION_URL=https://notification-service-xxxx-uc.a.run.app

# 9. Facturación Electrónica SUNAT (en Cloud Run pasar clave SOL, clave cert y cert Base64 por Secret Manager)
SUNAT_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_USUARIO_SOL=TU_USUARIO_SOL_SECUNDARIO
SUNAT_CLAVE_SOL=TU_CLAVE_SOL_EN_SECRET_MANAGER
SUNAT_CERT_PASSWORD=TU_PASSWORD_CERTIFICADO_EN_SECRET_MANAGER
SUNAT_CERT_BASE64=TU_CERTIFICADO_P12_EN_BASE64_EN_SECRET_MANAGER
SUNAT_FIRMA_ALGORITMO=SHA1
SUNAT_RUC=20608945123
SUNAT_RAZON_SOCIAL=POLLERIA SAN POLLO DE ICA S.A.C.
SUNAT_NOMBRE_COMERCIAL=POLLERIA SAN POLLO DE ICA
SUNAT_DIRECCION=AV. SAN MARTIN 456
SUNAT_UBIGEO=110101
SUNAT_DEPARTAMENTO=ICA
SUNAT_PROVINCIA=ICA
SUNAT_DISTRITO=ICA
