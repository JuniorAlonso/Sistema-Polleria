# facturacion-sunat-service — copia a facturacion-sunat-service/.env (NO lo subas a git)
# Lo común (DB_*, JWT_SECRET, INTERNAL_API_KEY, CORS) se lee también de ../.env

# --- SUNAT beta (pruebas) ---
SUNAT_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_USUARIO_SOL=MODDATOS
SUNAT_CLAVE_SOL=moddatos
SUNAT_CERT_RUTA=./certificado/certificado-beta.p12
# En Cloud Run o entornos sin volumen local, usa SUNAT_CERT_BASE64 en lugar de SUNAT_CERT_RUTA:
# SUNAT_CERT_BASE64=
SUNAT_CERT_PASSWORD=cambia_esta_clave
SUNAT_FIRMA_ALGORITMO=SHA1

# --- Datos de la pollería ---
SUNAT_RUC=20608945123
SUNAT_RAZON_SOCIAL=POLLERIA SAN POLLO DE ICA S.A.C.
SUNAT_NOMBRE_COMERCIAL=POLLERIA SAN POLLO DE ICA
SUNAT_DIRECCION=AV. SAN MARTIN 456
SUNAT_UBIGEO=110101
SUNAT_DEPARTAMENTO=ICA
SUNAT_PROVINCIA=ICA
SUNAT_DISTRITO=ICA

FINANCE_SERVICE_URL=http://localhost:8087
ORDERS_SERVICE_URL=http://localhost:8082
