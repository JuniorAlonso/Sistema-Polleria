PORT=3001
NODE_ENV=development

# Sesión de WhatsApp (se crea al escanear el QR; no subir a git)
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# RNF10: espera entre mensajes (ms)
WHATSAPP_RATE_LIMIT_MS=10000
WHATSAPP_MAX_INTENTOS=3

# Historial (RF32). Si se omite, se guarda en memoria y se pierde al reiniciar.
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@localhost:5432/polleria

# Mismo secreto que auth-service: obligatorio para proteger endpoints ADMIN
JWT_SECRET=mismo_secreto_que_auth_service_minimo_32_chars

# Clave compartida con otros microservicios (header X-Internal-Key). Obligatoria (fail-closed).
INTERNAL_API_KEY=misma_clave_interna_compartida
NOTIFICATION_API_KEY=misma_clave_notificaciones_compartida

# Microservicios relacionados
ORDERS_SERVICE_URL=http://localhost:8082
PAYMENTS_SERVICE_URL=http://localhost:8083

# Almacenamiento MinIO / S3 para comprobantes de pago
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=tu_minio_access_key
MINIO_SECRET_KEY=tu_minio_secret_key
MINIO_BUCKET=polleria-comprobantes

# Frontend autorizado (separar con comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200

POLLERIA_TELEFONO=(056) 123-456
