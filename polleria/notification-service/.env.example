PORT=3001
NODE_ENV=development

# Sesión de WhatsApp (se crea al escanear el QR; no subir a git)
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# RNF10: espera entre mensajes (ms)
WHATSAPP_RATE_LIMIT_MS=10000
WHATSAPP_MAX_INTENTOS=3

# Historial (RF32). Si se omite, se guarda en memoria y se pierde al reiniciar.
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/polleria

# Mismo secreto que auth-service: protege GET /historial (solo ADMIN)
JWT_SECRET=mismo_secreto_que_auth_service_minimo_32_chars

# Clave compartida con orders-service y payments-service (header X-Internal-Key).
# Si se deja vacía, /whatsapp/pago y /whatsapp/estado no piden clave.
NOTIFICATION_API_KEY=

# Frontend que puede ver el historial (separar con comas)
CORS_ALLOWED_ORIGINS=http://localhost:4200

POLLERIA_TELEFONO=(056) 123-456
